ENVIRONMENT=development
# Railway: reference the private DATABASE_URL from the PostGIS service.
DATABASE_URL=postgresql+psycopg://mano:local-development-only@postgres:5432/manosalwa
# Railway: reference the private REDIS_URL from the Redis service.
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
# JSON array of exact HTTPS web origins. Native apps do not require CORS.
CORS_ORIGINS=[]
# Development-only OTP bypass. Leave unset in staging and production.
OTP_DEBUG_CODE=
# Backend-only. Leave unset to keep Mano in deterministic fallback mode.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
