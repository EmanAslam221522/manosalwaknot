ENVIRONMENT=development
# Runtime connection. Use Neon pooled TLS in hosted environments.
DATABASE_URL=postgresql+psycopg://mano:local-development-only@postgres:5432/manosalwa
# Optional migration connection. Use Neon direct TLS; defaults to DATABASE_URL locally.
MIGRATIONS_DATABASE_URL=
# Use the Upstash Redis TCP/TLS rediss:// URL in hosted environments, not its REST URL.
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
# JSON array of exact HTTPS web origins. Native apps do not require CORS.
CORS_ORIGINS=[]
# Development-only OTP bypass. Leave unset in staging and production.
OTP_DEBUG_CODE=
# Backend-only. Leave unset to keep Mano in deterministic fallback mode.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
